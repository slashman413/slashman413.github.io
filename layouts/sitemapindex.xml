{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range . }}
  {{- /* ja/es are noindexed placeholder languages — don't reference their (empty) sitemaps */ -}}
  {{- $lang := .Language.Lang }}
  {{- if or (eq $lang "ja") (eq $lang "es") }}{{ continue }}{{ end }}
  <sitemap>
    <loc>{{ .SitemapAbsURL }}</loc>
  </sitemap>
  {{- end }}
</sitemapindex>
